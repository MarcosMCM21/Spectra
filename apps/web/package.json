{
  "name": "@spectra/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SPA React + Vite + Tailwind + Zustand (:5173): Lobby de Salas Fixas, Showroom (Grid/Foco), OSD e slots de Addons.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "node scripts/wait-for-hub.mjs && vite --port 5173 --strictPort",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@spectra/contracts": "workspace:*",
    "@spectra/media-client": "workspace:*",
    "@spectra/shared-ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
