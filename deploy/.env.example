# ============================================================================
# SPECTRA — VARIÁVEIS DE AMBIENTE (MODELO SANITIZADO PARA GIT / CLINE IA)
# Copie este arquivo para .env e preencha com seus dados reais.
# ============================================================================

# --- Domínio e Proxy Reverso (Caddy + DuckDNS) ---
DOMAIN=seu-subdominio.duckdns.org
CADDY_HTTPS_PORT=8443
DUCKDNS_TOKEN=seu_token_duckdns_aqui

# --- Hub executado no servidor host ---
HUB_PORT=3001

# --- Topologia de rede host (Caddy e LiveKit no servidor) ---
LIVEKIT_UPSTREAM=127.0.0.1:7880

# --- Hub em produção ---
NODE_ENV=production
HUB_HOST=127.0.0.1
HUB_DB_PATH=./data/hub.sqlite

# --- Credenciais do LiveKit (use o mesmo par no Hub e no LiveKit) ---
LIVEKIT_URL=wss://seu-subdominio.duckdns.org:8443
LIVEKIT_API_KEY=SUBSTITUA_POR_UMA_CHAVE
LIVEKIT_API_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE
